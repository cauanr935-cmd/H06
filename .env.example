# Configuração do DocuSeal para o Route Handler /api/init-form.
#
# Dev:  copie para .env.local e preencha (o .env.local está no .gitignore).
# Prod: cadastre as mesmas chaves em Environment Variables na Vercel.
#
# NENHUMA destas pode receber o prefixo NEXT_PUBLIC_ — isso injetaria o valor
# no bundle do browser. Todas são lidas só em código server-side.

# URL base da instância DocuSeal, sem barra final.
# Ex.: https://docuseal.h06.online
DOCUSEAL_URL=

# Token da API do DocuSeal. Admin -> Settings -> API. É segredo: nunca commitar.
DOCUSEAL_TOKEN=

# ID numérico do template da carta de intenção.
# Está na URL do template no admin: /templates/<id>
DOCUSEAL_TEMPLATE_ID=

# Nome EXATO do papel (role) definido no template. Precisa ser: Manifestante
# Divergência aqui é a causa mais comum de erro na criação da submission.
SUBMITTER_ROLE=

# Opcional. Rótulo de origem gravado em metadata.origem de cada submission,
# útil para distinguir campanhas depois. Default: lp-carbono
# LEAD_ORIGEM=lp-carbono

# URL base da LP, sem barra final. Usada para montar o completed_redirect_url
# que o DocuSeal chama ao terminar a assinatura (volta para /obrigado).
# Dev: http://localhost:3000
# Prod: domínio da Vercel (ex.: https://h06.vercel.app ou o domínio customizado)
APP_URL=

# Segredo compartilhado de POST /api/docuseal/webhook. Gere um valor aleatório
# (ex.: openssl rand -hex 32) e cole o MESMO valor como header customizado no
# DocuSeal: Settings -> Webhooks -> (sua URL) -> aba "Secret" ->
# header "X-Webhook-Secret" = este valor.
WEBHOOK_SECRET=

# Opcionais. Rate limit de POST /api/init-form (5 requisições por IP a cada
# 10min) contra a REST API do Upstash Redis. Sem elas o endpoint continua
# funcionando normalmente, só sem essa proteção (fail-open).
# Provisionar: Vercel -> Marketplace -> Upstash (Redis, tier grátis) ->
# conectar ao projeto (injeta as env vars automaticamente); ou criar conta
# direto em upstash.com e colar as credenciais do painel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
